[Unit]
Description=CrowdCount Main Service (Provisioning + Streaming)
After=network-online.target bluetooth.target crowdcount-firstboot.service
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/counter/crowdcount-counter
ExecStart=/usr/bin/python3 /home/counter/crowdcount-counter/crowdcount-main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Never give up restarting — this is the core service
StartLimitIntervalSec=0

# Environment
Environment=PYTHONUNBUFFERED=1

# Allow time for network to come up
ExecStartPre=/bin/sleep 5

[Install]
WantedBy=multi-user.target
