[Unit]
Description=CrowdCount Main Service (Provisioning + Streaming)
After=network-online.target bluetooth.target tailscaled.service crowdcount-firstboot.service
Wants=network-online.target bluetooth.target tailscaled.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/counter/crowdcount-counter
ExecStart=/usr/bin/python3 /home/counter/crowdcount-counter/crowdcount-main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Allow 10 restarts per 10 minutes, then stop to avoid crash loop resource drain
StartLimitIntervalSec=600
StartLimitBurst=10

# Environment
Environment=PYTHONUNBUFFERED=1

# Allow time for network to come up
ExecStartPre=/bin/sleep 5

[Install]
WantedBy=multi-user.target
