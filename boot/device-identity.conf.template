# CrowdCount Device Identity
# This file is written during manufacturing to /boot/firmware/device-identity.conf
#
# DO NOT MODIFY THIS FILE - it contains factory-programmed device identity
# This file survives OS reflashes and contains all device-specific configuration

[DEFAULT]
# Unique device identifier (hostname - 5 characters)
# Used as: hostname, stream name, Bluetooth name
DEVICE_ID=

# Device secret for Bluetooth provisioning pairing
DEVICE_SECRET=

# Device password for 'counter' user SSH access
DEVICE_PASSWORD=

# API password for status updates to CrowdCount API
API_PASSWORD=

# Per-device Upstream API token (SRT dual-mode). The device auto-provisions
# this itself on first boot with current firmware (the updater's enroll step
# writes it here), so a manufacturing-time value is optional. Without a token
# the device always streams legacy RTSP, whatever its streaming_mode flag says.
#UPSTREAM_API_TOKEN=

# Git branch the auto-updater tracks. Defaults to main (the fleet deploy) when
# absent; set it to pin a device to a pre-release branch.
#UPDATE_BRANCH=

# Manufacturing information (auto-generated)
MANUFACTURING_DATE=
MODEL=counter-v3
HARDWARE_VERSION=1.0
FIRMWARE_VERSION=1.0
SERIAL_NUMBER=
