[Unit]
Description=CrowdCount Auto-Updater (git pull + version reporting)
After=network-online.target crowdcount-firstboot.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/counter/crowdcount-counter
ExecStart=/usr/bin/python3 /home/counter/crowdcount-counter/crowdcount-updater.py
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

# Allow 5 restarts per 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=5

# Environment
Environment=PYTHONUNBUFFERED=1

# Allow time for network + firstboot SSH key setup
ExecStartPre=/bin/sleep 15

[Install]
WantedBy=multi-user.target
