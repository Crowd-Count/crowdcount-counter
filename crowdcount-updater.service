[Unit]
Description=CrowdCount Auto-Updater (git pull + version reporting)
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/counter/crowdcount-counter
ExecStart=/usr/bin/python3 /home/counter/crowdcount-counter/crowdcount-updater.py
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

# Environment
Environment=PYTHONUNBUFFERED=1

# Allow time for network to come up
ExecStartPre=/bin/sleep 10

[Install]
WantedBy=multi-user.target
