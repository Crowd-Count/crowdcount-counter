# Device Configuration File
# This file contains settings that are IDENTICAL on all devices
# Device-specific settings (ID, passwords) come from /boot/firmware/device-identity.conf

# MediaMTX server Tailscale IP address (same for all devices)
SERVER_IP=100.72.64.80

# =============================================================================
# SERVER ENVIRONMENT TOGGLE
# =============================================================================
# Set to "true" to connect to development server, "false" for production
# Production: RTSP port 8554, API port 5000
# Development: RTSP port 8555, API port 5001
USE_DEV_SERVER=false

# RTSP port (auto-set based on USE_DEV_SERVER, but can be overridden)
RTSP_PORT=8554

# Video settings (same for all devices)
WIDTH=640
HEIGHT=480
FPS=15

# CrowdCount API URL for device status updates
API_URL=https://api.crowdcount.tech

# Tailscale auth key (reusable, same for all devices)
# Note: Key expiry (90 days) only prevents NEW authentications
#       Already-authenticated devices continue working indefinitely
# When key expires, generate new one at: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=tskey-auth-kJKxfwtXQG11CNTRL-LFr48oKos5WDkXDsw9qA6WZUB6wMzMzPE
